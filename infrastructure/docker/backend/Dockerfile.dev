FROM node:22-alpine

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@latest --activate

COPY pnpm-lock.yaml ./
COPY package.json ./
COPY apps/backend/package.json ./apps/backend/

RUN pnpm install

COPY apps/backend ./apps/backend

WORKDIR /app/apps/backend

EXPOSE 3333

CMD ["pnpm", "run", "dev"]