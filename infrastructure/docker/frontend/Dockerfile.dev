FROM node:22-alpine

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@latest --activate

COPY pnpm-lock.yaml ./
COPY package.json ./
COPY apps/frontend/package.json ./apps/frontend/

RUN pnpm install

COPY apps/frontend ./apps/frontend

WORKDIR /app/apps/frontend

EXPOSE 4200

CMD ["pnpm", "start", "--host", "0.0.0.0"]