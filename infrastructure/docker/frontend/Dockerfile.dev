FROM node:22-alpine

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@9.12.0 --activate

COPY pnpm-lock.yaml ./
COPY pnpm-workspace.yaml ./
COPY package.json ./
COPY turbo.json ./

COPY apps/frontend ./apps/frontend/

RUN pnpm install --frozen-lockfile

RUN chown -R node:node /app

WORKDIR /app/apps/frontend

EXPOSE 4200

USER node

CMD ["pnpm", "dev"]